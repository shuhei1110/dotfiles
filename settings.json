{
    "workbench.colorTheme": "Default Dark Modern",
    "editor.autoSurround": "brackets",
    "files.autoSave": "afterDelay",
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "window.zoomLevel": -1,
    "remote.SSH.remotePlatform": {
        "aicon-a100-": "linux",
        "aicon-a100": "linux",
        "ssm-smaope-t4": "linux",
        "aws-aicon-yoshida": "linux"
    },

    // エクスプローラー操作用のキーバインド自作関数
    "multiCommand.commands": [
        {
            "command": "multiCommand.focusDown5",
            "sequence": [
                "list.focusDown",
                "list.focusDown",
                "list.focusDown",
                "list.focusDown",
                "list.focusDown",
            ]
        },
        {
            "command": "multiCommand.focusUp5",
            "sequence": [
                "list.focusUp",
                "list.focusUp",
                "list.focusUp",
                "list.focusUp",
                "list.focusUp",
            ]
        },
    ],

    "vim.useSystemClipboard": true,
    "vim.hlsearch": true,
    "vim.insertModeKeyBindings": [
        {
            "before": ["j", "j"],
            "after": ["<Esc>"]
        }
    ],

    "vim.normalModeKeyBindingsNonRecursive": [
        {"before": ["H"], "after": ["0"]},
        {"before": ["f", "h"], "after": ["1", "0", "h"]},
        {"before": ["L"], "after": ["$"]},
        {"before": ["f", "l"], "after": ["1", "0", "l"]},
        {"before": ["J"], "after": ["1", "0", "j"]},
        {"before": ["K"], "after": ["1", "0", "k"]},
        {"before": ["U"], "after": ["C-r"]},
        {"before": ["d"], "after": ["\"", "_", "d"]},
        {"before": ["d", "d"], "after": ["\"", "_", "d", "d"]},
    ],
    
    "vim.visualModeKeyBindingsNonRecursive": [
        {"before": ["H"], "after": ["0"]},
        {"before": ["f", "h"], "after": ["1", "0", "h"]},
        {"before": ["L"], "after": ["$"]},
        {"before": ["f", "l"], "after": ["1", "0", "l"]},
        {"before": ["J"], "after": ["1", "0", "j"]},
        {"before": ["K"], "after": ["1", "0", "k"]},
        {"before": ["d", "f"], "after": ["\"", "_", "d"]},
        {"before": ["d", "d"], "after": ["\"", "_", "d", "d"]},
    ],
    "editor.quickSuggestions": {
        "strings": "on",
        "comments": "on"
    },
    "dev.containers.executeInWSL": true,
    "dev.containers.executeInWSLDistro": "Ubuntu",
    "notebook.lineNumbers": "on",
    "@azure.argTenant": "bb4fa01c-5da9-44f5-b082-8718ce8bf0a9",
    "chat.editing.alwaysSaveWithGeneratedChanges": true,
    "terminal.integrated.enableMultiLinePasteWarning": false,

}
